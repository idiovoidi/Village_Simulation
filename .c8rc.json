{
  "all": true,
  "include": [
    "server.js",
    "MyHavokSimCode/**/*.js",
    "assets/**/*.js"
  ],
  "exclude": [
    "node_modules/**",
    "test-*.js",
    "run-*.js",
    "coverage/**",
    ".vscode/**",
    "**/*.test.js",
    "**/*.spec.js"
  ],
  "reporter": [
    "html",
    "text",
    "lcov",
    "json"
  ],
  "report-dir": "./coverage",
  "temp-directory": "./coverage/tmp",
  "clean": true,
  "check-coverage": true,
  "lines": 60,
  "functions": 60,
  "branches": 50,
  "statements": 60
}
