{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Village Sim (Chrome)",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/ecs-rebuild",
      "preLaunchTask": "Start ECS Dev Server",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "type": "msedge",
      "request": "launch",
      "name": "Village Sim (Edge)",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/ecs-rebuild",
      "preLaunchTask": "Start ECS Dev Server",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ]
}
