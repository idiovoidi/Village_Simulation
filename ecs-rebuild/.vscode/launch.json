{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ECS: Debug with Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": {
        "webpack:///src/*": "${webRoot}/src/*"
      },
      "preLaunchTask": "ECS: npm run dev",
      "postDebugTask": "Terminate All Tasks"
    },
    {
      "name": "ECS: Debug with Edge",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": {
        "webpack:///src/*": "${webRoot}/src/*"
      },
      "preLaunchTask": "ECS: npm run dev",
      "postDebugTask": "Terminate All Tasks"
    }
  ]
}
