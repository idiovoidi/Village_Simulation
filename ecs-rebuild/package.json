{
  "name": "3d-village-sim-ecs-rebuild",
  "version": "1.0.0",
  "type": "module",
  "description": "TypeScript ECS rebuild of 3D Village Simulation",
  "main": "src/main.ts",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test --experimental-transform-types src/**/*.test.ts",
    "test:coverage": "c8 node --test --experimental-transform-types src/**/*.test.ts",
    "test:watch": "node --test --watch --experimental-transform-types src/**/*.test.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "c8": "^10.1.3",
    "eslint": "^9.15.0",
    "fast-check": "^4.5.3",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "keywords": [
    "babylon.js",
    "3d",
    "simulation",
    "ecs",
    "typescript"
  ],
  "author": "",
  "license": "ISC"
}
