{
  "name": "3d-village-sim-havok-babylon",
  "version": "1.0.0",
  "type": "module",
  "description": "3D Village Simulation using Babylon.js and Havok Physics",
  "main": "index.html",
  "scripts": {
    "start": "node server.js",
    "start:browser": "node launch-with-browser.js",
    "dev": "vite",
    "dev:old": "node dev-server.js",
    "dev:basic": "nodemon server.js",
    "build": "vite build",
    "build:old": "node build-validate.js && tsc",
    "preview": "vite preview",
    "build:dev": "npm run lint && tsc",
    "build:watch": "tsc --watch",
    "build:production": "node build-validate.js && tsc --project tsconfig.prod.json",
    "build:fast": "tsc",
    "type-check": "tsc --noEmit",
    "prebuild": "node build-validate.js",
    "test": "npm run validate && node run-performance-tests.js && node run-cpu-profiler-tests.js && node run-data-storage-tests.js",
    "test:dev": "npm run lint && node run-performance-tests.js && node run-cpu-profiler-tests.js && node run-data-storage-tests.js",
    "test:no-lint": "node run-performance-tests.js && node run-cpu-profiler-tests.js && node run-data-storage-tests.js",
    "test:coverage": "c8 --reporter=html --reporter=text --reporter=lcov npm run test:no-lint",
    "test:coverage:server": "c8 --reporter=html --reporter=text node test-fastify.js",
    "coverage:browser": "node test-browser-coverage.js",
    "coverage:report": "c8 report --reporter=html --reporter=text-summary",
    "coverage:analyze": "node analyze-coverage.js",
    "coverage:full": "npm run test:coverage && npm run coverage:analyze",
    "coverage:open": "start coverage\\index.html",
    "coverage:demo": "node demo-coverage.js",
    "lint": "npx eslint MyHavokSimCode/",
    "lint:fix": "npx eslint MyHavokSimCode/ --fix",
    "lint:all": "npx eslint .",
    "lint:all:fix": "npx eslint . --fix",
    "lint:ts": "npx eslint **/*.ts **/*.tsx",
    "lint:ts:fix": "npx eslint **/*.ts **/*.tsx --fix",
    "lint:check": "npx eslint MyHavokSimCode/ --max-warnings 0",
    "validate": "node build-validate.js",
    "ci": "npm run validate && npm run build && npm run test:no-lint"
  },
  "dependencies": {
    "@babylonjs/core": "^8.29.0",
    "@babylonjs/gui": "^8.29.0",
    "@babylonjs/havok": "^1.3.10",
    "@babylonjs/inspector": "^8.29.0",
    "@babylonjs/loaders": "^8.29.0",
    "@babylonjs/materials": "^8.29.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "c8": "^10.1.3",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "http-server": "^14.1.1",
    "nodemon": "^3.1.10",
    "puppeteer": "^23.11.1",
    "typescript": "^5.7.2",
    "vite": "^7.3.1"
  },
  "keywords": [
    "babylon.js",
    "3d",
    "simulation",
    "village",
    "havok",
    "physics"
  ],
  "author": "",
  "license": "ISC"
}