{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "module": "ES2022",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    
    "baseUrl": "./",
    "typeRoots": ["./node_modules/@types", "./types"]
  },
  "include": [
    "ecs-rebuild/**/*.ts",
    "assets/**/*.ts",
    "types/**/*.d.ts"
  ],
  "files": [
    "types/index.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist", 
    "coverage",
    "docs",
    "memory-bank",
    "**/*.test.ts",
    "**/*.test.js",
    "test-*.js",
    "run-*-tests.js"
  ]
}